# ==========================================
# BookHub - Root Environment Variable Example
# ==========================================

# Database
DATABASE_URL="file:./dev.db" # Or postgresql://username:password@localhost:5432/bookhub

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET="your_jwt_secret_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# External APIs
GEMINI_API_KEY="your_gemini_api_key"
GOOGLE_BOOKS_API_KEY="your_google_books_api_key"

# Cloudinary (Optional, falls back to local storage)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Redis Cache (Optional, falls back to in-memory)
REDIS_URL="redis://localhost:6379"
